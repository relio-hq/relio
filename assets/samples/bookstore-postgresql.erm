			<logical_name>도서별 판매 집계</logical_name>
			<description>취소되지 않은 주문의 도서별 판매 수량과 매출</description>
			<sql>SELECT b.BOOK_ID, b.TITLE, SUM(oi.QUANTITY) AS SOLD_QUANTITY, SUM(oi.QUANTITY * oi.UNIT_PRICE) AS SALES_AMOUNT&#x0A;FROM BOOK b&#x0A;JOIN ORDER_ITEM oi ON oi.BOOK_ID = b.BOOK_ID&#x0A;JOIN ORDERS o ON o.ORDER_ID = oi.ORDER_ID&#x0A;WHERE o.ORDER_STATUS &lt;&gt; &apos;CANCELED&apos;&#x0A;GROUP BY b.BOOK_ID, b.TITLE</sql>
