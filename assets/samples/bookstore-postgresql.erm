			<sql>SELECT c.CUSTOMER_ID, c.CUSTOMER_NAME, c.GRADE_CODE, COUNT(o.ORDER_ID) AS ORDER_COUNT, COALESCE(SUM(o.TOTAL_AMOUNT), 0) AS TOTAL_AMOUNT&#x0A;FROM CUSTOMER c&#x0A;LEFT JOIN ORDERS o ON o.CUSTOMER_ID = c.CUSTOMER_ID&#x0A;GROUP BY c.CUSTOMER_ID, c.CUSTOMER_NAME, c.GRADE_CODE</sql>
